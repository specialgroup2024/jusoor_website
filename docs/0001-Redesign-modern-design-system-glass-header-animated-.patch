+              </a>
+            </li>
+          </ul>
+        </div>
+      </div>
+      <div className="footer-legal">
+        <p>
+          © {year} {siteContent.companyName[locale]} — {ui.footerRights}
+        </p>
+      </div>
+    </footer>
+  );
+}
